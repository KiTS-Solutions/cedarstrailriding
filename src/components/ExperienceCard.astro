---
interface Props {
  name: string;
  audience: string;
}

const { name, audience } = Astro.props;
---

<article class="card flex flex-col gap-2 p-5">
  <h3 class="font-display text-lg font-semibold text-cedar-deep">{name}</h3>
  {audience && <p class="text-sm text-ink/80">{audience}</p>}
</article>
