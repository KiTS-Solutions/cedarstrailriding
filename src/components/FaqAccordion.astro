---
interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-cedar-deep/10 rounded-2xl border border-cedar-deep/10 bg-sand">
  {
    items.map((item) => (
      <details class="group">
        <summary class="flex min-h-14 cursor-pointer list-none items-center px-5 py-3 font-display text-base font-semibold text-cedar-deep marker:content-none">
          <span class="flex w-full items-center justify-between gap-4">
            {item.question}
            <span class="shrink-0 text-gold-deep transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
          </span>
        </summary>
        <p class="px-5 pb-5 text-sm text-ink/80">{item.answer}</p>
      </details>
    ))
  }
</div>
