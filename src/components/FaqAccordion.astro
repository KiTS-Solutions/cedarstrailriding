---
interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-cedar-deep/10 rounded-2xl border border-cedar-deep/10 bg-sand">
  {
    items.map((item) => (
      <details class="group p-5">
        <summary class="cursor-pointer list-none font-display text-base font-semibold text-cedar-deep marker:content-none">
          <span class="flex items-center justify-between gap-4">
            {item.question}
            <span class="shrink-0 text-gold transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
          </span>
        </summary>
        <p class="mt-3 text-sm text-ink/80">{item.answer}</p>
      </details>
    ))
  }
</div>
