---
// Softened full-bleed copy of an AmbientVideo clip, the section-level twin of the hero's
// panel backdrop (ScrollHero.astro .ctr-hero__backdrop): same filter, same 1/3-resolution
// canvas. It does not load the clip itself — it mirrors frames from the AmbientVideo inside
// the nearest [data-ambient-scope] ancestor, so the two stay in sync and the clip is fetched
// and decoded once. Until a frame is drawn (or ever, under reduced motion / Save-Data) the
// blurred poster shows instead (src/scripts/ambient-video.ts).
import { withBase } from "../i18n";

interface Props {
  poster: string;
}

const { poster } = Astro.props;
---

<div class="ambient-backdrop" aria-hidden="true">
  <img src={withBase(poster)} alt="" width="54" height="96" loading="lazy" decoding="async" />
  <canvas width="1" height="1" data-ambient-backdrop></canvas>
  <div class="ambient-backdrop__scrim"></div>
</div>

<style>
  .ambient-backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .ambient-backdrop img,
  .ambient-backdrop canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(6px) saturate(1.15) brightness(0.62);
    transform: scale(1.04);
  }
  .ambient-backdrop canvas {
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .ambient-backdrop canvas[data-drawn] {
    opacity: 1;
  }
  /* Keeps the copy at AA contrast over bright sky in the footage: heaviest behind the text
     (inline start), lightest behind the sharp panel. */
  .ambient-backdrop__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to var(--scrim-dir, right),
      rgb(60 71 16 / 0.7),
      rgb(60 71 16 / 0.35) 60%,
      rgb(60 71 16 / 0.15)
    );
  }
  :global([dir="rtl"]) .ambient-backdrop__scrim {
    --scrim-dir: left;
  }
  @media (max-width: 767px) {
    /* Stacked layout: text above, panel below. */
    .ambient-backdrop__scrim {
      --scrim-dir: bottom;
    }
    :global([dir="rtl"]) .ambient-backdrop__scrim {
      --scrim-dir: bottom;
    }
  }
</style>

<script>
  import { initAmbientBackdrops } from "../scripts/ambient-video";

  initAmbientBackdrops(document.querySelectorAll<HTMLCanvasElement>("[data-ambient-backdrop]"));
</script>
