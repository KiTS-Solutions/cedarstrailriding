---
import { contact } from "../data/siteSettings";
import { useTranslations, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
const phoneDigits = contact.whatsapp.replace(/[^0-9]/g, "");
const waHref = `https://wa.me/${phoneDigits}?text=${encodeURIComponent("Hello Cedars Trail Riding! I'd like to book a ride.")}`;
const telHref = `tel:${contact.phones[0]?.replace(/\s+/g, "")}`;
---

<div
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-cedar-deep/10 bg-warm-white/95 px-3 pt-2 backdrop-blur lg:hidden"
  style="padding-bottom: max(0.5rem, env(safe-area-inset-bottom));"
  data-sticky-contact
>
  <a
    href={waHref}
    target="_blank"
    rel="noopener noreferrer"
    class="btn-primary min-h-12"
  >
    {t("cta.whatsapp")}
  </a>
  <a href={telHref} class="btn-secondary min-h-12">
    {t("cta.call")}
  </a>
</div>
