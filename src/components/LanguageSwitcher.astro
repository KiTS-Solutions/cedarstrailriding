---
import { LOCALES, LOCALE_LABEL, path, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  route: string;
  class?: string;
}

const { locale, route, class: className = "" } = Astro.props;
---

<div
  class:list={["flex items-center gap-1 rounded-full border border-cedar-deep/20 p-1 text-sm", className]}
  role="group"
  aria-label="Language"
>
  {
    LOCALES.map((loc) => (
      <a
        href={path(route, loc)}
        aria-current={loc === locale ? "true" : undefined}
        class:list={[
          "inline-flex min-h-11 min-w-11 items-center justify-center rounded-full px-3 transition-colors duration-200",
          loc === locale
            ? "bg-cedar-deep text-warm-white"
            : "text-cedar-deep hover:bg-cedar-deep/10",
        ]}
      >
        {LOCALE_LABEL[loc]}
      </a>
    ))
  }
</div>
