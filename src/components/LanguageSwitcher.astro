---
import { LOCALES, LOCALE_LABEL, path, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  route: string;
}

const { locale, route } = Astro.props;
---

<div class="flex items-center gap-0.5 rounded-full border border-cedar-deep/20 text-sm" role="group" aria-label="Language">
  {
    LOCALES.map((loc) => (
      <a
        href={path(route, loc)}
        aria-current={loc === locale ? "true" : undefined}
        class:list={[
          "flex min-h-11 min-w-11 items-center justify-center rounded-full px-2 transition-colors duration-200",
          loc === locale
            ? "bg-cedar-deep text-warm-white"
            : "text-cedar-deep hover:bg-cedar-deep/10",
        ]}
      >
        {LOCALE_LABEL[loc]}
      </a>
    ))
  }
</div>
