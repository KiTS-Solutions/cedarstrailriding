---
import { useTranslations, type Locale } from "../i18n";
import { trails } from "../data/trails";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<form
  id="booking-form"
  data-success-message={t("form.success")}
  action="https://api.web3forms.com/submit"
  method="POST"
  class="grid grid-cols-2 gap-x-3 gap-y-4 rounded-2xl bg-sand p-4 sm:gap-4 sm:p-6"
>
  <input type="hidden" name="access_key" value={web3formsKey ?? ""} />
  <input type="hidden" name="subject" value="New booking request — Cedars Trail Riding" />
  <input type="hidden" name="from_name" value="Cedars Trail Riding website" />
  {/* Web3Forms honeypot: bots that fill hidden fields get silently marked as spam. */}
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

  {
    turnstileSiteKey && (
      <>
        <script async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js" />
        <div class="cf-turnstile col-span-2" data-sitekey={turnstileSiteKey} />
      </>
    )
  }

  {
    !web3formsKey && (
      <p class="rounded-lg bg-terracotta/10 p-3 text-sm text-terracotta col-span-2" role="note">
        Booking form is running without a Web3Forms access key yet (PUBLIC_WEB3FORMS_ACCESS_KEY) —
        submissions won't be delivered until it's set in .env.
      </p>
    )
  }

  <label class="col-span-2 flex flex-col gap-1 text-sm font-medium text-ink sm:col-span-1">
    {t("form.name")} *
    <input required type="text" name="name" autocomplete="name" class="field" />
  </label>

  <label class="col-span-2 flex flex-col gap-1 text-sm font-medium text-ink sm:col-span-1">
    {t("form.phone")} *
    <input required type="tel" name="phone" autocomplete="tel" inputmode="tel" placeholder="+961 XX XXX XXX" dir="ltr" class="field" />
  </label>

  <label class="col-span-2 flex flex-col gap-1 text-sm font-medium text-ink sm:col-span-1">
    {t("form.email")}
    <input type="email" name="email" autocomplete="email" inputmode="email" class="field" />
  </label>

  <label class="col-span-2 flex flex-col gap-1 text-sm font-medium text-ink sm:col-span-1">
    {t("form.interest")} *
    <select required name="interest" class="field">
      <option value="trail">{t("form.interest.trail")}</option>
      <option value="trek">{t("form.interest.trek")}</option>
      <option value="group">{t("form.interest.group")}</option>
      <option value="custom">{t("form.interest.custom")}</option>
      <option value="unsure" selected>{t("form.interest.unsure")}</option>
    </select>
  </label>

  <label class="col-span-2 flex flex-col gap-1 text-sm font-medium text-ink sm:col-span-1">
    {t("form.trailOrDuration")}
    <select name="trail" class="field">
      <option value="">—</option>
      {trails.map((trail) => <option value={trail.name}>{trail.name}</option>)}
    </select>
  </label>

  <label class="flex flex-col gap-1 text-sm font-medium text-ink">
    {t("form.date")}
    <input type="date" name="date" class="field" />
  </label>

  <label class="flex flex-col gap-1 text-sm font-medium text-ink">
    {t("form.riders")}
    <input type="number" min="1" name="riders" inputmode="numeric" class="field" />
  </label>

  <label class="flex flex-col gap-1 text-sm font-medium text-ink">
    {t("form.experience")}
    <select name="experience" class="field">
      <option value="none">{t("form.experience.none")}</option>
      <option value="beginner">{t("form.experience.beginner")}</option>
      <option value="intermediate">{t("form.experience.intermediate")}</option>
      <option value="advanced">{t("form.experience.advanced")}</option>
    </select>
  </label>

  <label class="flex flex-col gap-1 text-sm font-medium text-ink">
    {t("form.languagePreference")}
    <select name="language_preference" class="field">
      <option value="en">English</option>
      <option value="ar">العربية</option>
      <option value="fr">Français</option>
    </select>
  </label>

  <label class="col-span-2 flex flex-col gap-1 text-sm font-medium text-ink">
    {t("form.message")}
    <textarea name="message" rows="4" class="field"></textarea>
  </label>

  <label class="col-span-2 flex min-h-11 items-start gap-3 text-sm text-ink">
    <input required type="checkbox" name="consent" class="mt-0.5 size-6 shrink-0 accent-cedar-deep" />
    <span>{t("form.consent")}</span>
  </label>

  <p class="form-note col-span-2 text-xs text-ink/60">{t("form.disclaimer")}</p>

  <button type="submit" class="btn-primary col-span-2 min-h-12 sm:w-fit">
    {t("form.send")}
  </button>

  <p class="success-message hidden rounded-lg bg-cedar-deep/10 p-3 text-sm font-medium text-cedar-deep col-span-2" role="status"></p>
</form>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>("#booking-form");

  forms.forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const successEl = form.querySelector<HTMLParagraphElement>(".success-message");
      const successMessage = form.dataset.successMessage ?? "Thanks! We'll be in touch soon.";

      if (submitButton) submitButton.disabled = true;

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          form.reset();
          form.querySelectorAll("label, input, select, textarea, button, .form-note").forEach((el) => {
            // Inline style, not the `hidden` utility: labels carry `flex`, which would win.
            (el as HTMLElement).style.display = "none";
          });
          if (successEl) {
            successEl.textContent = successMessage;
            successEl.classList.remove("hidden");
          }
        } else if (submitButton) {
          submitButton.disabled = false;
        }
      } catch {
        if (submitButton) submitButton.disabled = false;
      }
    });
  });
</script>
