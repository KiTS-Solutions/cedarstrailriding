---
import { path, useTranslations, type Locale } from "../i18n";
import { brand, contact, social, brandFamily } from "../data/siteSettings";
import LebanonMap from "./LebanonMap.astro";
import WhatsAppButton from "./WhatsAppButton.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();

const exploreLinks = [
  { label: t("nav.trails"), route: "/trails/" },
  { label: t("nav.treks"), route: "/treks/" },
  { label: t("nav.groups"), route: "/groups/" },
  { label: t("nav.horses"), route: "/horses/" },
];

const companyLinks = [
  { label: t("nav.about"), route: "/about/" },
  { label: t("nav.gallery"), route: "/gallery/" },
  { label: t("nav.faq"), route: "/faq/" },
];
---

<footer class="bg-cedar-deep text-warm-white">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[2fr_1fr_1fr_1fr_1.4fr]">
      <div>
        <p class="font-display text-xl font-semibold">{brand.name}</p>
        <p class="mt-2 max-w-xs text-sm text-warm-white/80">{brand.positioning}</p>
        <p class="mt-3 text-sm text-gold">{t("label.managedBy")}</p>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-gold">{t("footer.explore")}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          {
            exploreLinks.map((link) => (
              <li>
                <a href={path(link.route, locale)} class="hover:underline">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-gold">{t("footer.company")}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          {
            companyLinks.map((link) => (
              <li>
                <a href={path(link.route, locale)} class="hover:underline">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-gold">{t("footer.contact")}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={`tel:${contact.phones[0]?.replace(/\s+/g, "")}`} class="hover:underline">{contact.phones[0]}</a></li>
          <li><a href={`tel:${contact.phones[1]?.replace(/\s+/g, "")}`} class="hover:underline">{contact.phones[1]}</a></li>
          <li><a href={`mailto:${contact.email}`} class="hover:underline">{contact.email}</a></li>
          <li><WhatsAppButton label={t("cta.whatsapp")} class="mt-1 !bg-gold !text-cedar-deep !py-1.5 !px-4 text-sm" /></li>
        </ul>
        <h3 class="mt-6 text-sm font-semibold uppercase tracking-wide text-gold">{t("footer.follow")}</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={brand.instagram} target="_blank" rel="noopener noreferrer" class="hover:underline">@{brand.instagram.split("/").filter(Boolean).pop()}</a></li>
          <li><a href={social.instagram_parent.handle ? `https://www.instagram.com/${social.instagram_parent.handle}/` : "#"} target="_blank" rel="noopener noreferrer" class="hover:underline">@{social.instagram_parent.handle}</a></li>
          <li><a href={brand.facebook} target="_blank" rel="noopener noreferrer" class="hover:underline">Facebook</a></li>
        </ul>
      </div>

      <div class="flex flex-col items-center gap-4 md:items-end">
        <LebanonMap label={t("footer.lebanonMapLabel")} class="text-gold" />
        <div class="flex flex-wrap items-center justify-center gap-3 md:justify-end">
          {
            brandFamily.map((entry) =>
              entry.href ? (
                <a
                  href={entry.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-lg bg-warm-white p-2 shadow-sm transition-transform hover:scale-105"
                  title={entry.name}
                >
                  <img src={entry.logoSrc} alt={entry.name} class="h-10 w-10 rounded object-contain" />
                </a>
              ) : (
                <span class="rounded-lg bg-warm-white p-2 shadow-sm" title={entry.name}>
                  <img src={entry.logoSrc} alt={entry.name} class="h-10 w-10 rounded object-contain" />
                </span>
              ),
            )
          }
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-warm-white/15 pt-6 text-xs text-warm-white/70 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {brand.name} · Samqaniyeh, Beiteddine, Lebanon</p>
      <p>{t("footer.siteLanguage")}</p>
    </div>
  </div>
</footer>
