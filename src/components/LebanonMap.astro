---
// District-accurate Lebanon map (Mount Lebanon tinted) with a pin at CTR's base
// coordinates (33.6864028, 35.5902012) — see src/data/siteSettings.ts footerMap.
// Sourced from the client's own live site; its baked-in background matches our
// cedar-deep footer, so it sits borderless. Never mirror this for RTL — it's a
// real map, not a decorative glyph.
import { footerMapSrc } from "../data/siteSettings";
import { withBase } from "../i18n";

interface Props {
  label: string;
  class?: string;
}

const { label, class: className = "" } = Astro.props;
---

<figure class:list={["flex flex-col items-center gap-2 text-center", className]}>
  <img src={withBase(footerMapSrc)} alt={label} width="160" height="160" loading="lazy" decoding="async" class="h-40 w-40 rounded-xl object-contain" dir="ltr" />
  <figcaption class="text-sm font-medium">{label}</figcaption>
</figure>
