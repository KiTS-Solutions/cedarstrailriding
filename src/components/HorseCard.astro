---
import type { Horse } from "../data/horses";

interface Props {
  horse?: Horse;
  comingSoonLabel?: string;
  class?: string;
  /** h2 when the card sits directly under the page's h1 (/horses/), h3 under a section h2. */
  headingLevel?: 2 | 3;
}

const { horse, comingSoonLabel, class: className = "", headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
---

{
  horse ? (
    <article class:list={["card flex flex-col gap-2 p-5", className]}>
      <div class="aspect-[4/5] rounded-xl bg-cedar-soft/20" />
      <Heading class="font-display text-lg font-semibold text-cedar-deep">{horse.name}</Heading>
      {horse.personality && <p class="text-sm text-ink/80">{horse.personality}</p>}
    </article>
  ) : (
    <article class:list={["card flex flex-col items-center justify-center gap-2 p-5 text-center", className]}>
      <div class="aspect-[16/9] w-full rounded-xl bg-cedar-soft/10 sm:aspect-[4/5]" />
      <p class="text-sm font-medium text-cedar-soft">{comingSoonLabel}</p>
    </article>
  )
}
