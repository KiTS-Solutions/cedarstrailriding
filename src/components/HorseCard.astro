---
import type { Horse } from "../data/horses";

interface Props {
  horse?: Horse;
  comingSoonLabel?: string;
}

const { horse, comingSoonLabel } = Astro.props;
---

{
  horse ? (
    <article class="card flex flex-col gap-2 p-5">
      <div class="aspect-[4/5] rounded-xl bg-cedar-soft/20" />
      <h3 class="font-display text-lg font-semibold text-cedar-deep">{horse.name}</h3>
      {horse.personality && <p class="text-sm text-ink/80">{horse.personality}</p>}
    </article>
  ) : (
    <article class="card flex flex-col items-center justify-center gap-2 p-5 text-center">
      <div class="aspect-[4/5] w-full rounded-xl bg-cedar-soft/10" />
      <p class="text-sm font-medium text-cedar-soft">{comingSoonLabel}</p>
    </article>
  )
}
