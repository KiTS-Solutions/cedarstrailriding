---
import { contact } from "../data/siteSettings";

interface Props {
  label: string;
  message?: string;
  class?: string;
  /** Optional analytics hook: rendered as data-hero-cta when set. */
  heroCta?: string;
}

const { label, message = "Hello Cedars Trail Riding! I'd like to book a ride.", class: className = "", heroCta } =
  Astro.props;

const phoneDigits = contact.whatsapp.replace(/[^0-9]/g, "");
const href = `https://wa.me/${phoneDigits}?text=${encodeURIComponent(message)}`;
---

<a href={href} target="_blank" rel="noopener noreferrer" data-hero-cta={heroCta} class:list={["btn-primary", className]}>
  {label}
</a>
