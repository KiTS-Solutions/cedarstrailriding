---
// Home hero: one screen, the v2 clip autoplays on a seamless 13 s loop and the three acts
// cross-fade in time with its three shots (src/scripts/scroll-hero.ts, timings in
// hero-math.ts). Without JS, or under reduced motion / Save-Data / 2G / low memory, it stays
// "static": the poster and Act I only.
import { useTranslations, path, withBase, type Locale } from "../i18n";
import { contact } from "../data/siteSettings";
import { heroMedia, HERO_MOBILE_MEDIA } from "../data/heroMedia";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const { lat, lng } = contact.coordinates;
const coords = `${lat.toFixed(2)}°N ${lng.toFixed(2)}°E`;
const media = withBase(heroMedia.dir);
const panel = heroMedia.layout === "panel";
const { poster } = heroMedia;

const chapters = [
  { id: "shouf", n: "01", label: t("hero.chapter1") },
  { id: "ridge", n: "02", label: t(heroMedia.copy.chapter2) },
  { id: "ride", n: "03", label: t("hero.chapter3") },
] as const;
---

<section
  class="ctr-hero"
  data-hero
  data-mode="static"
  data-layout={heroMedia.layout}
  data-fx={heroMedia.fx}
  data-video-desktop={`${media}/${heroMedia.video.desktop}`}
  data-video-mobile={`${media}/${heroMedia.video.mobile}`}
  data-video-compact={`${media}/${heroMedia.video.compact}`}
  aria-label={t("hero.aria")}
>
  <a href="#trails" class="ctr-hero__skip" data-hero-skip>{t("hero.skip")}</a>

  <div class="ctr-hero__stage" data-hero-stage>
    {
      panel && (
        <div class="ctr-hero__backdrop" aria-hidden="true">
          <picture>
            <source
              media={HERO_MOBILE_MEDIA}
              srcset={`${media}/${poster.mobile}`}
              type="image/webp"
            />
            <img src={`${media}/${poster.desktop.src}`} alt="" width="36" height="64" decoding="async" />
          </picture>
          <canvas width="1" height="1" data-hero-backdrop />
        </div>
      )
    }
    <div class="ctr-hero__plate" aria-hidden="true">
      <picture>
        <source
          media={HERO_MOBILE_MEDIA}
          srcset={`${media}/${poster.mobile}`}
          type="image/webp"
        />
        <img
          src={`${media}/${poster.desktop.src}`}
          alt=""
          width={poster.desktop.width}
          height={poster.desktop.height}
          fetchpriority="high"
          class="ctr-hero__poster"
        />
      </picture>
      <video
        class="ctr-hero__video"
        muted
        loop
        playsinline
        disablepictureinpicture
        preload="none"
        tabindex="-1"
        data-hero-video
      ></video>
    </div>

    <div class="ctr-hero__grade" aria-hidden="true"></div>
    <div class="ctr-hero__shafts" aria-hidden="true"></div>
    <canvas class="ctr-hero__fx" data-hero-fx aria-hidden="true"></canvas>
    <div class="ctr-hero__scrim" aria-hidden="true"></div>

    <nav class="ctr-hero__rail" aria-label={t("hero.railLabel")}>
      <ol>
        {
          chapters.map((c) => (
            <li>
              <a href={`#${c.id}`} data-chapter={c.id}>
                <span class="ctr-hero__rail-n">{c.n}</span>
                <span class="ctr-hero__rail-l">{c.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="ctr-hero__acts">
      <div class="ctr-hero__act ctr-hero__act--intro" data-act="intro">
        <p class="ctr-hero__eyebrow">{t("home.eyebrow")}</p>
        <h1 class="ctr-hero__h1">{t("brand.hero")}</h1>
        <p class="ctr-hero__lead">{t("home.heroSub")}</p>
        <div class="ctr-hero__ctas">
          <a href={path("/contact/", locale)} class="btn-primary" data-hero-cta="book">{t("cta.book")}</a>
          <a
            href="#trails"
            class="btn-secondary !border-warm-white !text-warm-white hover:!bg-warm-white hover:!text-cedar-deep"
            data-hero-cta="explore"
          >
            {t("cta.explore")}
          </a>
        </div>
        <div class="ctr-hero__chips">
          <span class="chip bg-warm-white/10">{t("label.ratedGoogle")}</span>
          <span class="chip bg-warm-white/10">{t("label.languages")}</span>
          <span class="chip bg-warm-white/10">{t("label.operateAllLebanon")}</span>
        </div>
      </div>

      <div class="ctr-hero__act ctr-hero__act--ridge" data-act="ridge">
        <p class="ctr-hero__eyebrow">{t("hero.act2.eyebrow")}</p>
        <h2 class="ctr-hero__h2">{t("hero.act2.title")}</h2>
        <p class="ctr-hero__lead">{t(heroMedia.copy.act2Body)}</p>
      </div>

      <div class="ctr-hero__act ctr-hero__act--ride" data-act="ride">
        <p class="ctr-hero__eyebrow">{t("hero.act3.eyebrow")}</p>
        <h2 class="ctr-hero__h2">{t("hero.act3.title")}</h2>
        <p class="ctr-hero__lead">{t("hero.act3.body")}</p>
        <div class="ctr-hero__ctas">
          <a href={path("/contact/", locale)} class="btn-primary" data-hero-cta="plan">{t("cta.plan")}</a>
        </div>
      </div>
    </div>

    <p class="ctr-hero__coords" aria-hidden="true">{t("hero.location")} · <bdi dir="ltr">{coords}</bdi></p>

    <!-- WCAG 2.2.2: motion that starts on its own and runs past 5 s needs a pause control. -->
    <button
      type="button"
      class="ctr-hero__toggle"
      aria-pressed="false"
      aria-label={t("hero.pause")}
      data-label-pause={t("hero.pause")}
      data-label-play={t("hero.play")}
      data-hero-toggle
    >
      <svg class="ctr-hero__icon-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor"></rect>
        <rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor"></rect>
      </svg>
      <svg class="ctr-hero__icon-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z" fill="currentColor"></path>
      </svg>
    </button>
  </div>
</section>

<style>
  .ctr-hero {
    /* First-paint estimate of everything above the hero, refined by JS (syncHeroTop). Only the
       trust bar counts: the header overlays the hero (Header.astro, data-overlay) and the stage
       pads itself by --site-header-h instead. Matching the common case keeps that refinement
       from moving the vertically centred copy, a layout shift. */
    --hero-top: 2.25rem;
    --p: 0;
    position: relative;
    background: var(--color-cedar-deep);
    color: var(--color-warm-white);
  }
  @media (max-width: 767px) {
    .ctr-hero {
      --hero-top: 3.5rem; /* the trust bar wraps to two lines on phones */
    }
  }
  .ctr-hero__stage {
    position: relative;
    isolation: isolate;
    overflow: clip;
    min-height: calc(100svh - var(--hero-top));
    min-height: calc(100dvh - var(--hero-top));
    padding-top: var(--site-header-h); /* clear of the overlaid header */
    display: flex;
    align-items: center;
  }

  /* ---- Layers ---- */
  .ctr-hero__plate {
    position: absolute;
    inset: 0;
    z-index: -3;
  }
  .ctr-hero__poster,
  .ctr-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ctr-hero__video {
    display: none;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .ctr-hero[data-mode="play"] .ctr-hero__video {
    display: block;
  }
  .ctr-hero[data-ready] .ctr-hero__video {
    opacity: 1;
  }
  .ctr-hero__grade {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(ellipse at 50% 45%, transparent 45%, rgb(22 17 12 / 0.55) 100%),
      linear-gradient(0deg, rgb(201 162 39 / 0.14), rgb(201 162 39 / 0.04));
    mix-blend-mode: multiply;
  }
  .ctr-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(22 17 12 / 0.74) 0%, rgb(22 17 12 / 0.38) 40%, rgb(22 17 12 / 0.06) 72%, rgb(22 17 12 / 0.3) 100%),
      linear-gradient(0deg, rgb(22 17 12 / 0.7) 0%, transparent 42%, rgb(22 17 12 / 0.24) 100%);
  }
  :global(html[dir="rtl"]) .ctr-hero__scrim {
    transform: scaleX(-1);
  }
  /* Narrow portrait: copy spans the full width, so darken evenly for legibility */
  @media (max-width: 767px) {
    .ctr-hero__scrim {
      background:
        linear-gradient(0deg, rgb(22 17 12 / 0.82) 0%, rgb(22 17 12 / 0.6) 55%, rgb(22 17 12 / 0.5) 100%);
    }
  }
  .ctr-hero__shafts,
  .ctr-hero__fx,
  .ctr-hero__rail,
  .ctr-hero__coords,
  .ctr-hero__toggle {
    display: none;
  }

  /* ---- Copy (static mode: normal flow, Act I only) ---- */
  .ctr-hero__acts {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    padding: 4rem 1.25rem;
  }
  .ctr-hero__act--ridge,
  .ctr-hero__act--ride {
    display: none;
  }
  .ctr-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold);
    text-shadow: 0 1px 10px rgb(22 17 12 / 0.75);
  }
  .ctr-hero__eyebrow::before {
    content: "";
    display: block;
    width: 2.25rem;
    height: 1px;
    background: currentColor;
  }
  .ctr-hero__h1,
  .ctr-hero__h2 {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 0.96;
    letter-spacing: -0.045em;
    text-wrap: balance;
    max-width: 14ch;
  }
  .ctr-hero__h1 {
    font-size: clamp(3rem, 7.2vw, 7rem);
  }
  .ctr-hero__h2 {
    font-size: clamp(2.6rem, 6vw, 5.75rem);
  }
  .ctr-hero__lead {
    margin-top: 1.5rem;
    max-width: 36rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: rgb(251 247 238 / 0.88);
  }
  .ctr-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .ctr-hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: rgb(251 247 238 / 0.8);
  }
  :global(html[dir="rtl"]) .ctr-hero__h1,
  :global(html[dir="rtl"]) .ctr-hero__h2,
  :global(html[dir="rtl"]) .ctr-hero__eyebrow {
    letter-spacing: 0;
    text-transform: none;
  }
  /* El Messiri's Arabic forms need room; Latin's tight 0.96 would clip them. */
  :global(html[dir="rtl"]) .ctr-hero__h1,
  :global(html[dir="rtl"]) .ctr-hero__h2 {
    line-height: 1.3;
  }

  .ctr-hero__skip {
    position: absolute;
    inset-inline-start: 1rem;
    top: calc(var(--site-header-h) + 0.75rem);
    z-index: 30;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--color-warm-white);
    color: var(--color-cedar-deep);
    font-weight: 600;
    transform: translateY(-200%);
    opacity: 0;
    pointer-events: none;
  }
  .ctr-hero__skip:focus,
  .ctr-hero__skip:focus-visible {
    transform: none;
    opacity: 1;
    pointer-events: auto;
  }

  /* ---- Play mode (JS-enabled, capable devices only) ----
     Still one screen: the acts stack in one grid cell (so the stage sizes to the tallest) and
     cross-fade in place as the loop plays. */
  .ctr-hero[data-mode="play"] .ctr-hero__acts {
    display: grid;
    padding-inline: 1.25rem;
  }
  .ctr-hero[data-mode="play"] .ctr-hero__act {
    grid-area: 1 / 1;
    display: block;
    align-self: center;
    width: min(46rem, 100%);
    opacity: var(--o, 0);
    translate: 0 calc((1 - var(--o, 0)) * 18px);
    will-change: opacity, translate;
  }
  .ctr-hero[data-mode="play"] .ctr-hero__act--intro {
    --o: 1;
  }
  .ctr-hero[data-mode="play"] .ctr-hero__act--ridge {
    justify-self: center;
    text-align: center;
  }
  .ctr-hero[data-mode="play"] .ctr-hero__act--ridge .ctr-hero__eyebrow {
    justify-content: center;
  }
  .ctr-hero[data-mode="play"] .ctr-hero__act--ridge .ctr-hero__h2,
  .ctr-hero[data-mode="play"] .ctr-hero__act--ridge .ctr-hero__lead {
    margin-inline: auto;
  }
  .ctr-hero[data-mode="play"] .ctr-hero__act--ride {
    justify-self: end;
    text-align: end;
  }
  .ctr-hero[data-mode="play"] .ctr-hero__act--ride .ctr-hero__eyebrow,
  .ctr-hero[data-mode="play"] .ctr-hero__act--ride .ctr-hero__ctas {
    justify-content: flex-end;
  }
  .ctr-hero[data-mode="play"] .ctr-hero__act--ride .ctr-hero__h2,
  .ctr-hero[data-mode="play"] .ctr-hero__act--ride .ctr-hero__lead {
    margin-inline-start: auto;
  }
  @media (min-width: 768px) {
    .ctr-hero[data-mode="play"] .ctr-hero__acts {
      max-width: none;
      padding-inline: 7.5rem 8vw;
    }
  }

  /* Chapter rail: the active chapter follows the footage, the gold line fills over the loop.
     Desktop: a vertical rail in the inline-start gutter. */
  .ctr-hero[data-mode="play"] .ctr-hero__rail {
    display: block;
    position: absolute;
    inset-inline-start: 1.25rem;
    top: calc(50% + var(--site-header-h) / 2); /* centred in the area below the header */
    z-index: 20;
    transform: translateY(-50%);
  }
  .ctr-hero__rail ol {
    position: relative;
    display: grid;
    gap: 1.75rem;
    padding-inline-start: 1rem;
    list-style: none;
    margin: 0;
  }
  .ctr-hero__rail ol::before,
  .ctr-hero__rail ol::after {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgb(251 247 238 / 0.3);
  }
  .ctr-hero__rail ol::after {
    background: var(--color-gold);
    transform-origin: 50% 0;
    transform: scaleY(var(--p));
  }
  .ctr-hero__rail a {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(251 247 238 / 0.55);
    transition: color 0.25s ease;
  }
  /* Invisible 44px-tall touch area around each 12px chapter marker. */
  .ctr-hero__rail a::after {
    content: "";
    position: absolute;
    inset: -0.75rem -0.6rem;
  }
  .ctr-hero__rail a[aria-current="true"] {
    color: var(--color-warm-white);
  }
  .ctr-hero__rail a[aria-current="true"] .ctr-hero__rail-n {
    color: var(--color-gold);
  }
  .ctr-hero__rail-l {
    display: none;
  }
  @media (min-width: 768px) {
    .ctr-hero__rail-l {
      display: inline;
    }
  }
  :global(html[dir="rtl"]) .ctr-hero__rail a {
    letter-spacing: 0;
    text-transform: none;
  }

  .ctr-hero[data-mode="play"] .ctr-hero__coords {
    display: block;
    position: absolute;
    inset-inline-start: 1.25rem;
    bottom: 1.1rem;
    z-index: 20;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: rgb(251 247 238 / 0.7);
  }
  :global(html[dir="rtl"]) .ctr-hero__coords {
    letter-spacing: 0;
    text-transform: none;
  }

  /* Pause / play */
  .ctr-hero[data-mode="play"] .ctr-hero__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: calc(var(--site-header-h) + 0.75rem);
    inset-inline-end: 0.75rem;
    z-index: 25;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid rgb(251 247 238 / 0.35);
    background: rgb(22 17 12 / 0.55);
    color: var(--color-warm-white);
    backdrop-filter: blur(8px);
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .ctr-hero__toggle:hover {
    background: rgb(22 17 12 / 0.8);
  }
  .ctr-hero__toggle:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
  }
  .ctr-hero__icon-play,
  .ctr-hero__toggle[aria-pressed="true"] .ctr-hero__icon-pause {
    display: none;
  }
  .ctr-hero__toggle[aria-pressed="true"] .ctr-hero__icon-play {
    display: block;
  }

  /* Phones: the rail runs along the bottom edge (numbers only), so the copy keeps the full
     width it has in static mode and the upgrade does not reflow it. */
  @media (max-width: 767px) {
    .ctr-hero[data-mode="play"] .ctr-hero__rail {
      top: auto;
      bottom: 1rem;
      inset-inline-start: 1.25rem;
      transform: none;
    }
    .ctr-hero__rail ol {
      grid-auto-flow: column;
      padding-inline-start: 0;
      padding-top: 0.75rem;
    }
    .ctr-hero__rail ol::before,
    .ctr-hero__rail ol::after {
      inset-inline: 0;
      bottom: auto;
      width: auto;
      height: 1px;
    }
    .ctr-hero__rail ol::after {
      transform-origin: 0 50%;
      transform: scaleX(var(--p));
    }
    :global(html[dir="rtl"]) .ctr-hero__rail ol::after {
      transform-origin: 100% 50%;
    }
    /* Phone Act I is tall enough that the bottom-edge coordinates collide with the chips. */
    .ctr-hero[data-mode="play"] .ctr-hero__coords {
      display: none;
    }
  }

  /* Ambient light shafts + FX canvas */
  .ctr-hero[data-mode="play"] .ctr-hero__shafts {
    display: block;
    position: absolute;
    inset: -20% -10%;
    z-index: -1;
    pointer-events: none;
    background: repeating-linear-gradient(
      105deg,
      transparent 0 9%,
      rgb(255 236 190 / 0.1) 9% 11%,
      transparent 11% 20%
    );
    mix-blend-mode: screen;
    opacity: 0.45;
    animation: ctr-shafts 14s ease-in-out infinite alternate;
  }
  .ctr-hero[data-paused] .ctr-hero__shafts {
    animation-play-state: paused;
  }
  @keyframes ctr-shafts {
    from {
      transform: translateX(-2%);
    }
    to {
      transform: translateX(3%);
    }
  }
  .ctr-hero[data-mode="play"] .ctr-hero__fx {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 0; /* above the video/scrim, below the copy (.ctr-hero__acts is z-index 1) */
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* ---- Panel layout (v2 vertical footage) ----
     Phones in portrait keep the full-bleed stage: 9:16 footage fits them exactly. Anything
     wider than 4:5 gets a full-height 3:4 panel at the inline end (a 3:4 window on the 9:16
     footage — wider, so larger, than a full 9:16 frame could be at the same height), a lightly
     softened copy of the same frame behind it, and all three acts on the inline-start side. */
  .ctr-hero__backdrop {
    display: none;
  }
  @media (min-aspect-ratio: 4/5) {
    .ctr-hero[data-layout="panel"] .ctr-hero__stage {
      --panel-gap: clamp(1rem, 2.4vh, 1.75rem);
      --panel-end: max(1.25rem, 4vw);
      /* Sized from the header alone (not --hero-top, which JS refines after first paint), so
         the panel never resizes once shown; the 2.5rem leaves room for the trust bar. */
      --panel-h: calc(100dvh - var(--site-header-h) - 2 * var(--panel-gap) - 2.5rem);
      --panel-w: min(calc(var(--panel-h) * 3 / 4), 46vw);
      --copy-start: 3rem;
    }
    .ctr-hero[data-layout="panel"] .ctr-hero__backdrop {
      display: block;
      position: absolute;
      inset: 0;
      z-index: -4;
      overflow: hidden;
    }
    .ctr-hero__backdrop img,
    .ctr-hero__backdrop canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      /* Light softening only: the canvas is drawn at a third of the stage resolution, so this
         reads as depth of field rather than a smear. */
      filter: blur(6px) saturate(1.15) brightness(0.62);
      transform: scale(1.04);
    }
    .ctr-hero__backdrop canvas {
      opacity: 0;
      transition: opacity 0.4s ease;
    }
    .ctr-hero[data-ready] .ctr-hero__backdrop canvas {
      opacity: 1;
    }
    .ctr-hero[data-layout="panel"] .ctr-hero__plate {
      inset: auto;
      top: calc(var(--site-header-h) + var(--panel-gap));
      inset-inline-end: var(--panel-end);
      width: var(--panel-w);
      height: calc(var(--panel-w) * 4 / 3);
      overflow: hidden;
      border-radius: 1.25rem;
      box-shadow:
        0 30px 80px -24px rgb(0 0 0 / 0.65),
        0 0 0 1px rgb(251 247 238 / 0.14);
    }
    .ctr-hero[data-layout="panel"] .ctr-hero__scrim {
      background:
        linear-gradient(90deg, rgb(22 17 12 / 0.7) 0%, rgb(22 17 12 / 0.42) 45%, rgb(22 17 12 / 0.12) 70%, transparent 85%),
        linear-gradient(0deg, rgb(22 17 12 / 0.5) 0%, transparent 35%);
    }
    .ctr-hero[data-layout="panel"] .ctr-hero__h1 {
      font-size: clamp(2.75rem, 5.4vw, 6rem);
    }
