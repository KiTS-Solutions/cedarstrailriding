---
// Small stroke icons for the header chrome (paths adapted from Lucide, ISC licence). Decorative:
// always aria-hidden, so the surrounding control must carry its own accessible name.
type IconName = "phone" | "whatsapp" | "pin" | "mail" | "menu" | "close" | "arrow" | "clock" | "mountain";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = "size-5" } = Astro.props;

const PHONE =
  "M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z";
---

<svg
  aria-hidden="true"
  viewBox="0 0 24 24"
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === "phone" && <path d={PHONE} />}
  {
    name === "whatsapp" && (
      <>
        <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
        <g transform="translate(12 12) scale(0.42) translate(-12 -12)" stroke-width="4.2">
          <path d={PHONE} />
        </g>
      </>
    )
  }
  {
    name === "pin" && (
      <>
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
        <circle cx="12" cy="10" r="3" />
      </>
    )
  }
  {
    name === "mail" && (
      <>
        <rect x="2" y="4" width="20" height="16" rx="2" />
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
      </>
    )
  }
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6L6 18" />}
  {name === "arrow" && <path d="M5 12h14M12 5l7 7-7 7" />}
  {
    name === "clock" && (
      <>
        <circle cx="12" cy="12" r="10" />
        <path d="M12 6v6l4 2" />
      </>
    )
  }
  {name === "mountain" && <path d="m8 3 4 8 5-5 5 15H2L8 3Z" />}
</svg>
