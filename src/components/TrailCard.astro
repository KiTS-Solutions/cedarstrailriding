---
import { useTranslations, type Locale } from "../i18n";
import type { Trail } from "../data/trails";

interface Props {
  trail: Trail;
  locale: Locale;
  /** h2 when the card sits directly under the page's h1 (/trails/), h3 under a section h2. */
  headingLevel?: 2 | 3;
}

const { trail, locale, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
const t = useTranslations(locale);

const chipKey: Record<NonNullable<Trail["difficulty"]>, { label: string; class: string }> = {
  "Beginner-Friendly": { label: t("chip.beginner"), class: "chip-beginner" },
  "Scenic Ride": { label: t("chip.scenic"), class: "chip-scenic" },
  "Adventure/Challenging": { label: t("chip.adventure"), class: "chip-adventure" },
};

const chip = trail.difficulty ? chipKey[trail.difficulty] : null;
const descriptor = t(`trail.${trail.id}.descriptor`);
const body = descriptor.startsWith("trail.") ? trail.summary : descriptor;
const durationKey = `trail.${trail.id}.duration`;
const durationText = trail.duration ? (t(durationKey) !== durationKey ? t(durationKey) : trail.duration) : null;
---

<article class="card flex flex-col gap-3 p-5">
  <div class="flex items-center justify-between gap-2">
    <Heading class="font-display text-lg font-semibold text-cedar-deep">{trail.name}</Heading>
    {trail.feature && <span class="chip bg-gold/20 text-cedar-deep">{t("chip.feature")}</span>}
  </div>
  {chip && <span class={chip.class}>{chip.label}</span>}
  <p dir="auto" class="text-sm text-ink/80">{body}</p>
  {durationText && <p dir="auto" class="text-xs font-medium uppercase tracking-wide text-cedar-soft">{durationText}</p>}
</article>
