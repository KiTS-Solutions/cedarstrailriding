---
import { useTranslations, withBase, type Locale } from "../i18n";
import type { Trail } from "../data/trails";
import WhatsAppButton from "./WhatsAppButton.astro";
import Icon from "./Icon.astro";

interface Props {
  trail: Trail;
  locale: Locale;
  /** h2 when the card sits directly under the page's h1 (/trails/), h3 under a section h2. */
  headingLevel?: 2 | 3;
}

const { trail, locale, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
const t = useTranslations(locale);

const chipKey: Record<NonNullable<Trail["difficulty"]>, { label: string; class: string }> = {
  "Beginner-Friendly": { label: t("chip.beginner"), class: "chip-beginner" },
  "Scenic Ride": { label: t("chip.scenic"), class: "chip-scenic" },
  "Adventure/Challenging": { label: t("chip.adventure"), class: "chip-adventure" },
};

const chip = trail.difficulty ? chipKey[trail.difficulty] : null;
const descriptor = t(`trail.${trail.id}.descriptor`);
const body = descriptor.startsWith("trail.") ? trail.summary : descriptor;
const durationKey = `trail.${trail.id}.duration`;
const durationText = trail.duration ? (t(durationKey) !== durationKey ? t(durationKey) : trail.duration) : null;
const askMessage = t("trail.askMessage").replace("{trail}", trail.name);

// Until the client's trail photos arrive (brief/07_image_assets.md), each card shows a ridge
// silhouette generated from its id: distinct per trail and honest (a drawing, not a photo of
// somewhere else). Deterministic, so builds are stable.
function rng(seed: string): () => number {
  let h = 2166136261;
  for (let i = 0; i < seed.length; i++) h = Math.imul(h ^ seed.charCodeAt(i), 16777619);
  return () => {
    h = Math.imul(h ^ (h >>> 15), 2246822507);
    h = Math.imul(h ^ (h >>> 13), 3266489909);
    return ((h ^= h >>> 16) >>> 0) / 4294967296;
  };
}
function ridge(rand: () => number, base: number, amp: number): string {
  const W = 320;
  const H = 200;
  const n = 7;
  const pts = Array.from({ length: n + 1 }, (_, i) => [(W / n) * i, base - rand() * amp] as const);
  let d = `M0 ${H} L${pts[0][0]} ${pts[0][1].toFixed(1)}`;
  for (let i = 1; i < pts.length; i++) {
    const [x0, y0] = pts[i - 1];
    const [x1, y1] = pts[i];
    const mx = (x0 + x1) / 2;
    d += ` Q${x0.toFixed(1)} ${y0.toFixed(1)} ${mx.toFixed(1)} ${((y0 + y1) / 2).toFixed(1)}`;
  }
  const last = pts[pts.length - 1];
  return `${d} T${last[0]} ${last[1].toFixed(1)} L${W} ${H} Z`;
}
const rand = rng(trail.id);
const farRidge = ridge(rand, 120, 70);
const nearRidge = ridge(rand, 165, 55);
---

<article
  class="trail-card card group relative flex h-full flex-col overflow-hidden"
  data-trail-card
  data-difficulty={trail.difficulty ?? "none"}
  data-multiday={trail.duration ? "true" : "false"}
>
  <div class="trail-card__media relative aspect-[16/10] overflow-hidden bg-cedar-deep">
    {
      trail.image ? (
        <img
          src={withBase(trail.image)}
          alt=""
          width="640"
          height="400"
          loading="lazy"
          decoding="async"
          class="trail-card__art h-full w-full object-cover"
        />
      ) : (
        <svg
          class="trail-card__art h-full w-full"
          viewBox="0 0 320 200"
          preserveAspectRatio="xMidYMid slice"
          aria-hidden="true"
        >
          <defs>
            <linearGradient id={`sky-${trail.id}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#c9a227" stop-opacity="0.35" />
              <stop offset="0.55" stop-color="#596334" />
              <stop offset="1" stop-color="#3c4710" />
            </linearGradient>
          </defs>
          <rect width="320" height="200" fill={`url(#sky-${trail.id})`} />
          <circle cx="248" cy="52" r="16" fill="#fbf7ee" opacity="0.18" />
          <path d={farRidge} fill="#3c4710" opacity="0.7" />
          <path d={nearRidge} fill="#1c241f" opacity="0.85" />
        </svg>
      )
    }
    <div class="topo-bg pointer-events-none absolute inset-0 text-gold" aria-hidden="true"></div>
    {
      trail.feature && (
        <span class="chip absolute start-3 top-3 bg-warm-white/90 text-cedar-deep shadow-sm">{t("chip.feature")}</span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col gap-3 p-5">
    <Heading class="font-display text-xl font-semibold text-cedar-deep">{trail.name}</Heading>
    <p dir="auto" class="text-sm text-ink/80">{body}</p>

    {
      (chip || durationText) && (
        <dl class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          {chip && (
            <div class="flex items-center gap-1.5">
              <dt class="sr-only">{t("trail.level")}</dt>
              <dd class={chip.class}>{chip.label}</dd>
            </div>
          )}
          {durationText && (
            <div class="flex items-center gap-1.5 text-cedar-soft">
              <dt>
                <Icon name="clock" class="size-4" />
                <span class="sr-only">{t("trail.duration")}</span>
              </dt>
              <dd dir="auto" class="font-medium">{durationText}</dd>
            </div>
          )}
        </dl>
      )
    }

    <div class="mt-auto pt-2">
      <WhatsAppButton
        label={t("trail.ask")}
        message={askMessage}
        variant="link"
        class="trail-card__ask"
      />
    </div>
  </div>
</article>

<style>
  .trail-card {
    transition:
      transform var(--dur-2) var(--ease-out-soft),
      box-shadow var(--dur-2) var(--ease-out-soft);
  }
  .trail-card__art {
    transition: transform var(--dur-3) var(--ease-out-soft);
  }
  .trail-card .topo-bg {
    opacity: 0.6;
  }
  @media (hover: hover) and (pointer: fine) {
    .trail-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 18px 40px -18px rgb(28 36 31 / 0.45);
    }
    .trail-card:hover .trail-card__art {
      transform: scale(1.05);
    }
  }
</style>
