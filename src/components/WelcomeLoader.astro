---
// First-visit welcome screen for the home page. Whether it shows is decided before first
// paint by the inline script BaseLayout puts in <head> when `welcome` is set (sets
// html[data-welcome="on"]); without it — no JS, reduced motion, Save-Data, a deep link or
// a repeat visit this session — this markup stays display:none and fetches nothing.
// It plays for at least ~5 s (welcome-loader.ts), enters and leaves with a staged fade, and
// a CSS animation fades it out at 8.7 s even if welcome-loader.ts never runs. Until the
// clip starts, the video box shows the poster as a CSS background (no inline script in the
// body: it let the parser yield a first paint before the page was tall enough to scroll,
// and the late scrollbar shifted the RTL layout).
import { useTranslations, withBase, type Locale } from "../i18n";
import { logoSrc } from "../data/siteSettings";
import { v2Clips } from "../data/heroMedia";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const poster = withBase(v2Clips.loader.poster);
---

<div class="ctr-loader" data-loader style={`--loader-poster: url("${poster}")`}>
  <div class="ctr-loader__backdrop" aria-hidden="true"></div>
  <div class="ctr-loader__panel" aria-hidden="true">
    <video
      class="ctr-loader__video"
      muted
      loop
      playsinline
      preload="none"
      width="540"
      height="960"
      data-src={withBase(v2Clips.loader.video)}
      data-loader-video></video>
  </div>
  <div class="ctr-loader__brand">
    <img src={withBase(logoSrc)} alt="" width="480" height="320" class="ctr-loader__logo" />
    <p class="ctr-loader__welcome">{t("loader.welcome")}</p>
    <div class="ctr-loader__bar" aria-hidden="true"><i></i></div>
  </div>
  <button type="button" class="ctr-loader__skip" data-loader-skip>{t("loader.skip")}</button>
</div>

<style>
  /* Motion: one easing for everything, so the staged pieces read as a single gesture. */
  .ctr-loader {
    --ease: cubic-bezier(0.22, 0.7, 0.2, 1);
    /* Symmetric curve for the final dissolve: no front-loaded jump, no lingering tail. */
    --ease-dissolve: cubic-bezier(0.65, 0, 0.35, 1);
    display: none;
  }
  :global(html[data-welcome="on"]) .ctr-loader {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--color-cedar-deep);
    color: var(--color-warm-white);
    /* Exit: the screen dissolves as one piece (footage still playing) once its copy has
       lifted away, revealing the hero underneath. */
    transition:
      opacity 1s var(--ease-dissolve) 0.2s,
      visibility 0s linear 1.2s;
    /* Fail-safe: gone by ~9.5 s even if the controller script never loads. */
    animation: ctr-loader-out 0.85s var(--ease) 8.7s forwards;
  }
  :global(html[data-welcome="on"]) .ctr-loader[data-state="out"] {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    /* The controller is handling the exit: the no-JS fail-safe must not cut across it. */
    animation: none;
  }
  @keyframes ctr-loader-out {
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }
  @keyframes ctr-loader-fade-in {
    from {
      opacity: 0;
    }
  }

  .ctr-loader__backdrop,
  .ctr-loader__panel {
    position: absolute;
    inset: 0;
  }
  .ctr-loader__backdrop {
    display: none;
    background: var(--loader-poster) center / cover no-repeat;
    filter: blur(6px) saturate(1.15) brightness(0.5);
    transform: scale(1.04);
    animation: ctr-loader-fade-in 1.2s var(--ease) both;
  }
  /* Entry: the panel fades up while the footage settles from a slight push-in. */
  .ctr-loader__panel {
    overflow: hidden;
    background: var(--loader-poster) center / cover no-repeat;
    animation: ctr-loader-fade-in 0.9s var(--ease) both;
  }
  .ctr-loader__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.08);
    animation: ctr-loader-settle 2.4s var(--ease) forwards;
    transition:
      opacity 0.6s var(--ease),
      transform 1.2s var(--ease-dissolve);
  }
  @keyframes ctr-loader-settle {
    to {
      transform: scale(1);
    }
  }
  /* Cross-fade from the poster to the clip once real frames play. */
  .ctr-loader__video[data-playing] {
    opacity: 1;
  }
  /* Phones in portrait: the flag fills the screen. Wider: a portrait panel over a soft copy. */
  @media (min-aspect-ratio: 4/5) {
    .ctr-loader__backdrop {
      display: block;
    }
    .ctr-loader__panel {
      inset: auto;
      top: 50%;
      left: 50%;
      height: min(86dvh, 60rem);
      aspect-ratio: 9 / 16;
      transform: translate(-50%, -50%);
      border-radius: 1.25rem;
      box-shadow: 0 30px 80px -24px rgb(0 0 0 / 0.65);
    }
  }
  .ctr-loader__panel::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(22 17 12 / 0.75) 0%, rgb(22 17 12 / 0.1) 45%, rgb(22 17 12 / 0.25) 100%);
  }

  .ctr-loader__brand {
    position: absolute;
    inset-inline: 0;
    bottom: max(12dvh, 5rem);
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    text-align: center;
    animation: ctr-loader-rise 0.9s var(--ease) 0.35s both;
    transition:
      opacity 0.45s var(--ease),
      transform 0.6s var(--ease);
  }
  @keyframes ctr-loader-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  .ctr-loader__skip {
    animation: ctr-loader-fade-in 0.6s var(--ease) 0.8s both;
    transition: opacity 0.3s var(--ease);
  }

  /* Exit, staged: copy lifts away first while the footage drifts gently forward; the whole
     screen then dissolves (transition above). The panel never fades on its own — that would
     flash the flat background between the footage and the hero. */
  .ctr-loader[data-state="out"] .ctr-loader__brand {
    animation: none;
    opacity: 0;
    transform: translateY(-12px);
  }
  .ctr-loader[data-state="out"] .ctr-loader__skip {
    animation: none;
    opacity: 0;
  }
  .ctr-loader[data-state="out"] .ctr-loader__video {
    animation: none;
    transform: scale(1.05);
  }

  .ctr-loader__logo {
    width: clamp(6.5rem, 22vw, 9rem);
    height: auto;
    /* The brand mark is dark green; render it as a warm-white silhouette on the footage. */
    filter: brightness(0) invert(0.97) sepia(0.12) drop-shadow(0 4px 18px rgb(0 0 0 / 0.55));
  }
  .ctr-loader__welcome {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 14px rgb(0 0 0 / 0.6);
    /* Fixed line box: the block is bottom-anchored, so a web-font swap that changed this
       line's height would move the logo above it (a layout shift). */
    height: 1.25em;
    line-height: 1.25;
    white-space: nowrap;
  }
  .ctr-loader__bar {
    width: 7rem;
    height: 2px;
    overflow: hidden;
    border-radius: 2px;
    background: rgb(251 247 238 / 0.25);
  }
  /* Fills over the minimum play time; completes on exit. */
  .ctr-loader__bar i {
    display: block;
    height: 100%;
    background: var(--color-gold);
    transform-origin: 0 50%;
    animation: ctr-loader-bar 3s cubic-bezier(0.3, 0.6, 0.4, 1) forwards;
    transition: transform 0.35s var(--ease);
  }
  :global(html[dir="rtl"]) .ctr-loader__bar i {
    transform-origin: 100% 50%;
  }
  .ctr-loader[data-state="out"] .ctr-loader__bar i {
    animation: none;
    transform: scaleX(1);
  }
  @keyframes ctr-loader-bar {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(0.94);
    }
  }

  .ctr-loader__skip {
    position: absolute;
    top: max(1rem, env(safe-area-inset-top));
    inset-inline-end: 1rem;
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem;
    border: 1px solid rgb(251 247 238 / 0.45);
    border-radius: 999px;
    background: rgb(22 17 12 / 0.35);
    backdrop-filter: blur(6px);
    color: var(--color-warm-white);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }
  .ctr-loader__skip:hover {
    background: rgb(22 17 12 / 0.55);
  }
  .ctr-loader__skip:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
  }
</style>

<script>
  import { initWelcomeLoader } from "../scripts/welcome-loader";

  const el = document.querySelector<HTMLElement>("[data-loader]");
  if (el) initWelcomeLoader(el);
</script>
