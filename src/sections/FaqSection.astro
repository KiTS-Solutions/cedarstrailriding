---
import { useTranslations, type Locale } from "../i18n";
import { faqItems } from "../data/faq";
import FaqAccordion from "../components/FaqAccordion.astro";
import PageBand from "../components/PageBand.astro";
import { v2Clips } from "../data/heroMedia";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const items = faqItems.map((_, index) => {
  const n = index + 1;
  return {
    question: t(`faq.${n}.q`),
    answer: t(`faq.${n}.a`),
  };
});
---

<PageBand
  locale={locale}
  title={t("faq.heading")}
  crumb={t("nav.faq")}
  lead={t("nav.faqDesc")}
  media={{ poster: v2Clips.ridge.poster }}
/>

<section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
  <div>
    <FaqAccordion items={items} />
  </div>
</section>
