---
import { useTranslations, path, type Locale } from "../i18n";
import { trails } from "../data/trails";
import TrailCard from "../components/TrailCard.astro";
import AmbientVideo from "../components/AmbientVideo.astro";
import { v2Clips } from "../data/heroMedia";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const multiDayTrails = trails.filter((trail) => trail.duration);
---

<section class="bg-cedar-deep px-4 py-16 text-warm-white sm:px-6">
  <div class="mx-auto grid max-w-5xl items-center gap-10 md:grid-cols-[1fr_auto]">
    <div class="text-center md:text-start">
      <h1 class="font-display text-4xl font-semibold">{t("home.treksHeading")}</h1>
      <p class="mt-4 text-warm-white/85">{t("home.treksLead")}</p>
    </div>
    <AmbientVideo
      video={v2Clips.ridge.video}
      poster={v2Clips.ridge.poster}
      class="mx-auto aspect-[4/5] w-full max-w-sm rounded-2xl shadow-2xl md:aspect-[9/16] md:w-72"
    />
  </div>
</section>

<section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
  <article class="card p-8">
    <h2 class="font-display text-2xl font-semibold text-cedar-deep">{t("treks.feature.title")}</h2>
    <p class="mt-3 text-ink/80">{t("treks.feature.body")}</p>
  </article>

  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    {multiDayTrails.map((trail) => <TrailCard trail={trail} locale={locale} />)}
  </div>

  <div class="mt-8 rounded-2xl bg-sand p-6 text-sm text-ink/80">
    <p class="font-semibold text-cedar-deep">{t("treks.inclusions")}</p>
    <p class="mt-2">{t("treks.inclusionsPending")}</p>
  </div>

  <div class="mt-8 text-center">
    <a href={path("/contact/", locale)} class="btn-primary">{t("cta.plan")}</a>
  </div>
</section>
