---
import { useTranslations, path, type Locale } from "../i18n";
import { trails } from "../data/trails";
import TrailCard from "../components/TrailCard.astro";
import PageBand from "../components/PageBand.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { v2Clips } from "../data/heroMedia";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const multiDayTrails = trails.filter((trail) => trail.duration);
---

<PageBand
  locale={locale}
  title={t("home.treksHeading")}
  crumb={t("nav.treks")}
  lead={t("home.treksLead")}
  media={v2Clips.ridge}
  transitionName="pathway-treks"
/>

<section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
  <article class="card topo-bg grid gap-6 overflow-hidden p-8 text-cedar-deep sm:p-10 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
    <div>
      <h2 class="font-display text-h2 font-semibold">{t("treks.feature.title")}</h2>
      <span class="gold-rule mt-5"></span>
      <p class="mt-5 max-w-xl text-ink/80">{t("treks.feature.body")}</p>
    </div>
    <WhatsAppButton label={t("cta.whatsapp")} message={t("trail.askMessage").replace("{trail}", t("treks.feature.title"))} />
  </article>

  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    {multiDayTrails.map((trail) => <TrailCard trail={trail} locale={locale} />)}
  </div>

  <div class="mt-8 rounded-2xl border border-gold/40 bg-warm-white p-6 text-sm text-ink/80">
    <p class="font-semibold text-cedar-deep">{t("treks.inclusions")}</p>
    <p class="mt-2">{t("treks.inclusionsPending")}</p>
  </div>

  <div class="mt-8 text-center">
    <a href={path("/contact/", locale)} class="btn-primary">{t("cta.plan")}</a>
  </div>
</section>
