---
import { useTranslations, type Locale } from "../i18n";
import { values } from "../data/siteSettings";
import { v2Clips } from "../data/heroMedia";
import PageBand from "../components/PageBand.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
// Value labels are translated per slug (value.<slug>); the canonical list stays in
// brief/05_site_facts.json.
const valueKey = (value: string) => `value.${value.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

<PageBand
  locale={locale}
  title={t("about.heading")}
  crumb={t("nav.about")}
  lead={t("nav.aboutDesc")}
  media={v2Clips.flag}
/>

<section class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-16">
  <div class="text-lg text-ink/85">
    <p>{t("about.body1")}</p>
    <p class="mt-5">{t("about.body2")}</p>

    <blockquote class="mt-10 border-s-2 border-gold ps-6 font-display text-2xl italic leading-snug text-cedar-deep">
      “{t("home.aboutQuote")}”
    </blockquote>
  </div>

  <aside class="flex flex-col gap-6">
    <div class="card topo-bg p-6 text-cedar-deep">
      <h2 class="font-display text-xl font-semibold">{t("about.whoHeading")}</h2>
      <span class="gold-rule mt-4"></span>
      <p class="mt-4 text-ink/80">{t("about.whoBody")}</p>
    </div>

    <div class="rounded-2xl border border-gold/40 bg-warm-white p-6">
      <h2 class="font-display text-xl font-semibold text-cedar-deep">{t("about.credentialHeading")}</h2>
      <p class="mt-2 text-sm text-ink/80">{t("about.credential")}</p>
    </div>
  </aside>
</section>

<section class="topo-bg bg-sand py-14 text-cedar-deep sm:py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="font-display text-h2 font-semibold">{t("about.valuesHeading")}</h2>
    <span class="gold-rule mt-5"></span>
    <ul class="mt-8 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {
        values.map((value, i) => (
          <li class="flex items-baseline gap-4 border-t border-cedar-deep/15 pt-4">
            <span class="font-display text-sm font-semibold text-gold-deep">{String(i + 1).padStart(2, "0")}</span>
            <span class="text-lg text-ink">{t(valueKey(value))}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
