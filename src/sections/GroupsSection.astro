---
import { useTranslations, path, type Locale } from "../i18n";
import ExperienceCard from "../components/ExperienceCard.astro";
import AmbientVideo from "../components/AmbientVideo.astro";
import { v2Clips } from "../data/heroMedia";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
  <h1 class="text-center font-display text-4xl font-semibold text-cedar-deep">{t("home.groupsHeading")}</h1>

  <div class="mt-10 grid items-center gap-6 md:grid-cols-[18rem_1fr] md:gap-10">
    <AmbientVideo
      video={v2Clips.group.video}
      poster={v2Clips.group.poster}
      class="mx-auto aspect-[4/5] w-full max-w-sm rounded-2xl md:aspect-[9/16] md:w-72"
    />
    <div class="grid gap-6 sm:grid-cols-3 md:grid-cols-1">
      <ExperienceCard name={t("groups.hiking")} audience={t("groups.hikingNote")} />
      <ExperienceCard name={t("groups.business")} audience={t("groups.businessNote")} />
      <ExperienceCard name={t("groups.custom")} audience="" />
    </div>
  </div>

  <div class="mt-10 text-center">
    <a href={path("/contact/", locale)} class="btn-primary">{t("cta.tellUsYourIdea")}</a>
  </div>
</section>
