---
import { useTranslations, path, type Locale } from "../i18n";
import ExperienceCard from "../components/ExperienceCard.astro";
import PageBand from "../components/PageBand.astro";
import { v2Clips } from "../data/heroMedia";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<PageBand
  locale={locale}
  title={t("home.groupsHeading")}
  crumb={t("nav.groups")}
  lead={t("nav.groupsDesc")}
  media={v2Clips.group}
  transitionName="pathway-groups"
/>

<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
  <div class="grid gap-6 sm:grid-cols-3">
    <ExperienceCard index={1} name={t("groups.hiking")} audience={t("groups.hikingNote")} />
    <ExperienceCard index={2} name={t("groups.business")} audience={t("groups.businessNote")} />
    <ExperienceCard index={3} name={t("groups.custom")} />
  </div>

  <div class="mt-10 text-center">
    <a href={path("/contact/", locale)} class="btn-primary">{t("cta.tellUsYourIdea")}</a>
  </div>
</section>
