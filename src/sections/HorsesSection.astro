---
import { useTranslations, type Locale } from "../i18n";
import { horses, HORSE_PLACEHOLDER_COUNT } from "../data/horses";
import HorseCard from "../components/HorseCard.astro";
import PageBand from "../components/PageBand.astro";
import { v2Clips } from "../data/heroMedia";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const horseSlots = horses.length > 0 ? horses : Array.from({ length: HORSE_PLACEHOLDER_COUNT }, () => undefined);
---

<PageBand
  locale={locale}
  title={t("home.horsesHeading")}
  crumb={t("nav.horsesShort")}
  lead={t("home.horsesIntro")}
  media={{ poster: v2Clips.group.poster }}
/>

<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 text-center">
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {horseSlots.map((horse, i) => (
        <HorseCard horse={horse} headingLevel={2} comingSoonLabel={t("horses.comingSoon")} class={!horse && i > 0 ? "max-sm:hidden" : ""} />
      ))}
  </div>
</section>
