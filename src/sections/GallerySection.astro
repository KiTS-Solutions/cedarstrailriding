---
import { useTranslations, type Locale } from "../i18n";
import { galleryImages, galleryPlaceholders } from "../data/gallery";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
  <h1 class="text-center font-display text-4xl font-semibold text-cedar-deep">{t("gallery.heading")}</h1>
  <p class="mx-auto mt-4 max-w-2xl text-center text-ink/80">{t("gallery.intro")}</p>

  <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
    {
      galleryImages.map((image) => (
        <img
          src={image.src}
          alt={image.alt}
          width="1440"
          height="960"
          loading="lazy"
          class="aspect-square w-full rounded-xl object-cover"
        />
      ))
    }
    {
      galleryPlaceholders.map((placeholder) => (
        <div class="flex aspect-square w-full items-center justify-center rounded-xl border-2 border-dashed border-cedar-soft/30 bg-sand p-3 text-center text-xs font-medium text-cedar-soft">
          {placeholder.label}
        </div>
      ))
    }
  </div>
</section>
