---
import { useTranslations, path, type Locale } from "../i18n";
import { trails } from "../data/trails";
import { testimonials } from "../data/testimonials";
import { faqItems } from "../data/faq";
import { horses, HORSE_PLACEHOLDER_COUNT } from "../data/horses";
import TrailCard from "../components/TrailCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import HorseCard from "../components/HorseCard.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import BookingForm from "../components/BookingForm.astro";
import ScrollHero from "../components/ScrollHero.astro";
import AmbientVideo from "../components/AmbientVideo.astro";
import AmbientBackdrop from "../components/AmbientBackdrop.astro";
import Icon from "../components/Icon.astro";
import { v2Clips } from "../data/heroMedia";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const previewFaq = faqItems.slice(0, 4).map((_, index) => {
  const n = index + 1;
  return { question: t(`faq.${n}.q`), answer: t(`faq.${n}.a`) };
});
// Pathway cards under the hero. Each desc string is "fact · fact · tagline" in every locale: the
// last segment leads as the tagline, the rest render as chips (a string without " · " is all tagline).
const pathways = [
  { href: "/trails/", title: t("home.ridesTitle"), desc: t("home.ridesDesc"), image: v2Clips.gallop.poster },
  { href: "/treks/", title: t("home.treksCardTitle"), desc: t("home.treksCardDesc"), image: v2Clips.ridge.poster },
  { href: "/groups/", title: t("home.groupsCardTitle"), desc: t("home.groupsCardDesc"), image: v2Clips.group.poster },
].map(({ desc, ...pathway }) => {
  const segments = desc.split(" · ");
  return { ...pathway, tagline: segments.at(-1) ?? desc, facts: segments.slice(0, -1) };
});
const horseSlots =horses.length > 0 ? horses : Array.from({ length: HORSE_PLACEHOLDER_COUNT }, () => undefined);
---

<ScrollHero locale={locale} />

<section data-pathways class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
  <ul class="grid gap-4 md:grid-cols-3 md:gap-6">
    {
      pathways.map((pathway) => (
        <li>
          <article class="group card relative flex h-full overflow-hidden has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-cedar-deep md:flex-col">
            <div class="relative w-28 shrink-0 overflow-hidden bg-cedar-deep sm:w-44 md:aspect-[4/3] md:w-auto">
              <img
                src={pathway.image}
                alt=""
                width="540"
                height="960"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 size-full object-cover object-[50%_62%] transition-transform duration-500 ease-out motion-safe:group-hover:scale-105"
              />
            </div>
            <div class="flex flex-1 flex-col p-4 sm:p-5 md:p-6">
              <div class="flex items-start justify-between gap-3">
                <h2 class="font-display text-lg font-semibold leading-snug text-cedar-deep md:text-xl">
                  <a href={path(pathway.href, locale)} class="after:absolute after:inset-0 focus-visible:outline-none">
                    {pathway.title}
                  </a>
                </h2>
                <span class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-full bg-gold/25 text-cedar-deep transition-colors duration-200 group-hover:bg-gold">
                  <Icon name="arrow" class="size-4 transition-transform duration-200 rtl:-scale-x-100 motion-safe:group-hover:translate-x-0.5 motion-safe:rtl:group-hover:-translate-x-0.5" />
                </span>
              </div>
              <p class="mt-1.5 text-sm text-ink/80 md:text-base">{pathway.tagline}</p>
              {pathway.facts.length > 0 && (
                <div class="mt-3 md:mt-auto md:pt-5">
                  <ul class="space-y-1 text-[0.8125rem] font-medium leading-snug text-cedar-soft md:border-t md:border-cedar-deep/10 md:pt-4 md:text-sm">
                    {pathway.facts.map((fact) => (
                      <li class="flex items-baseline gap-2">
                        <span aria-hidden="true" class="size-1.5 shrink-0 -translate-y-0.5 rounded-full bg-gold" />
                        {fact}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </article>
        </li>
      ))
    }
  </ul>
</section>

<section
  id="about"
  class="relative isolate overflow-hidden bg-cedar-deep px-4 py-12 text-warm-white sm:px-6 sm:py-16"
>
  <AmbientBackdrop video={v2Clips.gallop.video} poster={v2Clips.gallop.poster} scrim="even" />
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="font-display text-3xl font-semibold">{t("home.aboutHeading")}</h2>
    <p class="mt-4">{t("home.aboutBody")}</p>
    <blockquote class="mt-6 font-display text-xl italic">“{t("home.aboutQuote")}”</blockquote>
    <a href={path("/about/", locale)} class="mt-4 inline-flex min-h-11 items-center font-semibold text-warm-white underline">
      {t("cta.readStory")}
    </a>
  </div>
</section>

<section id="trails" class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
  <h2 class="text-center font-display text-3xl font-semibold text-cedar-deep">{t("home.trailsHeading")}</h2>
  <div class="snap-row mt-8 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3" tabindex="0" role="group" aria-label={t("home.trailsHeading")}>
    {trails.filter((trail) => trail.id !== "custom-trails").map((trail) => <TrailCard trail={trail} locale={locale} />)}
  </div>
  <p class="mt-6 text-center text-sm text-ink/70">{t("home.customNote")}</p>
  <div class="mt-4 text-center">
    <a href={path("/contact/", locale)} class="btn-primary">{t("cta.plan")}</a>
  </div>
</section>

<section
  id="treks"
  class="relative isolate overflow-hidden bg-cedar-deep px-4 py-16 text-warm-white sm:px-6"
  data-ambient-scope
>
  <AmbientBackdrop poster={v2Clips.ridge.poster} />
  <div class="mx-auto grid max-w-5xl items-center gap-10 md:grid-cols-[1fr_auto]">
    <div class="text-center md:text-start">
      <h2 class="font-display text-3xl font-semibold">{t("home.treksHeading")}</h2>
      <p class="mt-4">{t("home.treksLead")}</p>
      <div class="mt-6">
        <a href={path("/treks/", locale)} class="btn-primary">{t("cta.exploreTreks")}</a>
      </div>
    </div>
    <AmbientVideo
      video={v2Clips.ridge.video}
      poster={v2Clips.ridge.poster}
      class="mx-auto aspect-[4/5] w-full max-w-sm rounded-2xl shadow-2xl md:aspect-[9/16] md:w-72"
    />
  </div>
</section>

<section id="groups" class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
  <h2 class="text-center font-display text-3xl font-semibold text-cedar-deep">{t("home.groupsHeading")}</h2>
  <div class="mt-8 grid items-center gap-6 md:grid-cols-[18rem_1fr] md:gap-10">
    <AmbientVideo
      video={v2Clips.group.video}
      poster={v2Clips.group.poster}
      class="mx-auto aspect-[4/5] w-full max-w-sm rounded-2xl md:aspect-[9/16] md:w-72"
    />
    <div class="grid gap-6 sm:grid-cols-3 md:grid-cols-1">
      <article class="card p-6">
        <h3 class="font-display text-lg font-semibold text-cedar-deep">{t("groups.hiking")}</h3>
        <p class="mt-2 text-sm text-ink/80">{t("groups.hikingNote")}</p>
      </article>
      <article class="card p-6">
        <h3 class="font-display text-lg font-semibold text-cedar-deep">{t("groups.business")}</h3>
      </article>
      <article class="card p-6">
        <h3 class="font-display text-lg font-semibold text-cedar-deep">{t("groups.custom")}</h3>
      </article>
    </div>
  </div>
  <div class="mt-6 text-center">
    <a href={path("/contact/", locale)} class="btn-secondary">{t("cta.tellUsYourIdea")}</a>
  </div>
</section>

<section
  id="horses"
  class="relative isolate overflow-hidden bg-cedar-deep px-4 py-12 text-warm-white sm:px-6 sm:py-16"
>
  <AmbientBackdrop video={v2Clips.group.video} poster={v2Clips.group.poster} scrim="even" />
  <div class="mx-auto max-w-6xl text-center">
    <h2 class="font-display text-3xl font-semibold">{t("home.horsesHeading")}</h2>
    <p class="mx-auto mt-3 max-w-2xl">{t("home.horsesIntro")}</p>
    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      {horseSlots.map((horse, i) => (
        <HorseCard horse={horse} comingSoonLabel={t("horses.comingSoon")} class={!horse && i > 0 ? "max-sm:hidden" : ""} />
      ))}
    </div>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
  <h2 class="text-center font-display text-3xl font-semibold text-cedar-deep">{t("home.testimonialsHeading")}</h2>
  <div class="snap-row mt-8 sm:grid-cols-3 sm:gap-6" tabindex="0" role="group" aria-label={t("home.testimonialsHeading")}>
    {testimonials.map((testimonial) => <TestimonialCard testimonial={testimonial} />)}
  </div>
  <p class="mt-6 text-center text-sm font-medium text-cedar-soft">{t("home.testimonialsSource")}</p>
</section>

<section id="faq" class="bg-sand px-4 py-12 sm:px-6 sm:py-16">
  <div class="mx-auto max-w-3xl">
    <h2 class="text-center font-display text-3xl font-semibold text-cedar-deep">{t("nav.faq")}</h2>
    <div class="mt-8">
      <FaqAccordion items={previewFaq} />
    </div>
    <div class="mt-6 text-center">
      <a href={path("/faq/", locale)} class="inline-flex min-h-11 items-center font-semibold text-cedar-deep underline">{t("cta.viewFullFaq")}</a>
    </div>
  </div>
</section>

<section id="contact" class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
  <h2 class="text-center font-display text-3xl font-semibold text-cedar-deep">{t("home.contactHeading")}</h2>
  <p class="mx-auto mt-3 max-w-2xl text-center text-ink/80">{t("contact.body")}</p>
  <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center sm:gap-4">
    <WhatsAppButton label={t("cta.whatsapp")} class="min-h-12" />
    <a href="tel:+96170211041" class="btn-secondary min-h-12">{t("cta.call")} <bdi dir="ltr">+961 70 211 041</bdi></a>
  </div>
  <div class="mt-10">
    <BookingForm locale={locale} />
  </div>
</section>
