# Copy to .env and fill in as each credential becomes available.
# All are optional at build time — the site renders correctly with none of them set;
# each integration below only activates once its value is present (see
# PRELAUNCH_CHECKLIST.md for who to get these from).

# Web3Forms access key (https://web3forms.com) — powers the booking form on /contact/.
# Without it, the form renders with a visible dev-mode notice instead of submitting.
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
PUBLIC_GA4_ID=

# Meta (Facebook) Pixel ID.
PUBLIC_META_PIXEL_ID=

# Cloudflare Turnstile site key — adds bot protection on top of the honeypot field.
PUBLIC_TURNSTILE_SITE_KEY=
